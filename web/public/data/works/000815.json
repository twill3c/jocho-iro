, "h": []}, {"t": "遊びに出て子供かへらず、", "p": 0.0, "h": []}, {"t": "取り出して", "p": 0.0, "h": []}, {"t": "走らせて見る玩具の機関車。", "p": 0.0, "h": []}, {"t": "本を買ひたし、本を買ひたしと、", "p": 0.0, "h": []}, {"t": "あてつけのつもりではなけれど、", "p": 0.0, "h": []}, {"t": "妻に言ひてみる。", "p": 0.0, "h": []}, {"t": "旅を思ふ夫の心！", "p": 0.0, "h": []}, {"t": "叱り、泣く、妻子の心！", "p": -0.55, "h": [["叱り", -0.4, "anger", 0], ["泣く", -0.7, "sadness", 0]]}, {"t": "朝の食卓！", "p": 0.0, "h": []}, {"t": "家を出て五町ばかりは、", "p": 0.0, "h": []}, {"t": "用のある人のごとくに", "p": 0.0, "h": []}, {"t": "歩いてみたれど――", "p": 0.0, "h": []}, {"t": "痛む歯をおさへつつ、", "p": 0.0, "h": []}, {"t": "日が赤赤と、", "p": 0.0, "h": []}, {"t": "冬の靄の中にのぼるを見たり。", "p": 0.0, "h": []}, {"t": "いつまでも歩いてゐねばならぬごとき", "p": 0.0, "h": []}, {"t": "思ひ湧き来ぬ、", "p": 0.0, "h": []}, {"t": "深夜の町町。", "p": 0.0, "h": []}, {"t": "なつかしき冬の朝かな。", "p": 0.4, "h": [["なつかしき", 0.4, "like", 0]]}, {"t": "湯をのめば、", "p": 0.0, "h": []}, {"t": "湯気がやはらかに、顔にかかれり。", "p": -0.4, "h": [["や", -0.4, "dislike", 0]]}, {"t": "何となく、", "p": 0.0, "h": []}, {"t": "今朝は少しく、わが心明るきごとし。", "p": 0.4, "h": [["明る", 0.4, "calm", 0]]}, {"t": "手の爪を切る。", "p": 0.0, "h": []}, {"t": "うっとりと", "p": 0.0, "h": []}, {"t": "本の挿絵に眺め入り、", "p": 0.0, "h": []}, {"t": "煙草の煙吹きかけてみる。", "p": 0.0, "h": []}, {"t": "途中にて乗換の電車なくなりしに、", "p": 0.0, "h": []}, {"t": "泣かうかと思ひき。", "p": 0.0, "h": []}, {"t": "雨も降りてゐき。", "p": 0.0, "h": []}, {"t": "二晩おきに、", "p": 0.0, "h": []}, {"t": "夜の一時頃に切通の坂を上りしも――", "p": 0.0, "h": []}, {"t": "勤めなればかな。", "p": 0.0, "h": []}, {"t": "しっとりと", "p": 0.0, "h": []}, {"t": "酒のかをりにひたりたる", "p": 0.0, "h": []}, {"t": "脳の重みを感じて帰る。", "p": 0.0, "h": []}, {"t": "今日もまた酒のめるかな！", "p": 0.0, "h": []}, {"t": "酒のめば", "p": 0.0, "h": []}, {"t": "胸のむかつく癖を知りつつ。", "p": 0.0, "h": []}, {"t": "何事か今我つぶやけり。", "p": 0.0, "h": []}, {"t": "かく思ひ、", "p": 0.0, "h": []}, {"t": "目をうちつぶり、酔ひを味ふ。", "p": 0.0, "h": []}, {"t": "すっきりと酔ひのさめたる心地よさよ！", "p": 0.0, "h": []}, {"t": "夜中に起きて、", "p": 0.0, "h": []}, {"t": "墨を磨るかな。", "p": 0.0, "h": []}, {"t": "真夜中の出窓に出でて、", "p": 0.0, "h": []}, {"t": "欄干の霜に", "p